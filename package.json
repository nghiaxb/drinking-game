{
  "name": "drinking-games",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "test:unit": "vitest",
    "generate:assets": "node scripts/generate-assets.mjs",
    "generate:sounds": "node scripts/generate-sounds.mjs",
    "generate:static-seo": "tsx --tsconfig tsconfig.node.json scripts/generate-static-seo.ts",
    "generate:cap-assets": "npx capacitor-assets generate --assetPath assets --iconBackgroundColor \"#01070f\" --splashBackgroundColor \"#01070f\"",
    "prebuild": "npm run generate:assets && npm run generate:sounds && npm run generate:static-seo",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite-ssg build",
    "verify:dist": "tsx --tsconfig tsconfig.node.json scripts/verify-dist.ts",
    "audit:build": "tsx --tsconfig tsconfig.node.json scripts/audit-build.ts",
    "verify": "npm run type-check && npm run lint && npm run test:unit -- --run && npm run build && npm run verify:dist",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "audit:prod": "npm audit --omit=dev",
    "verify:release": "npm run verify && npm run test:e2e && npm run audit:prod",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tabler/icons-vue": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@unhead/vue": "^2.1.17",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.129.0"
  }
}
